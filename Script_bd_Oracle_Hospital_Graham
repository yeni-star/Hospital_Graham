--------------------------------------------------------------------------------
-- 1. TABLA PACIENTES
-- Tabla principal usada por el CRUD del FrontEnd Angular y el BFF.
--------------------------------------------------------------------------------

CREATE TABLE PACIENTES (
    ID_PACIENTE      NUMBER GENERATED BY DEFAULT ON NULL AS IDENTITY,
    NOMBRE_APELLIDO  VARCHAR2(150) NOT NULL,
    RUT              VARCHAR2(20) NOT NULL,
    CRITICIDAD       VARCHAR2(20) NOT NULL,
    FECHA_LLEGADA    DATE NOT NULL,
    FECHA_SALIDA     DATE,
    TEMPERATURA      NUMBER(4,1),
    HABITACION       VARCHAR2(50),
    SIGNOS_VITALES   VARCHAR2(300),
    CONSTRAINT PK_PACIENTES PRIMARY KEY (ID_PACIENTE)
);


--------------------------------------------------------------------------------
-- 2. TABLA PACIENTES_CRITICOS
-- Tabla de apoyo usada en experiencias anteriores.
-- En la versión final, ALERTAS_MEDICAS apunta a PACIENTES y no a esta tabla.
--------------------------------------------------------------------------------

CREATE TABLE PACIENTES_CRITICOS (
    ID_PACIENTE      NUMBER NOT NULL,
    NOMBRE_APELLIDO  VARCHAR2(150),
    CRITICIDAD       VARCHAR2(20),
    HABITACION       VARCHAR2(50),
    FECHA_REGISTRO   TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT PK_PACIENTES_CRITICOS PRIMARY KEY (ID_PACIENTE),
    CONSTRAINT FK_PACIENTES_CRITICOS_PACIENTE
        FOREIGN KEY (ID_PACIENTE)
        REFERENCES PACIENTES(ID_PACIENTE)
);


--------------------------------------------------------------------------------
-- 3. TABLA SIGNOS_VITALES
-- Guarda lecturas de signos vitales relacionadas a pacientes.
--------------------------------------------------------------------------------

CREATE TABLE SIGNOS_VITALES (
    ID_SIGNO              NUMBER GENERATED BY DEFAULT ON NULL AS IDENTITY,
    ID_PACIENTE           NUMBER NOT NULL,
    FRECUENCIA_CARDIACA   NUMBER,
    PRESION_SISTOLICA     NUMBER,
    PRESION_DIASTOLICA    NUMBER,
    TEMPERATURA           NUMBER(4,1),
    SATURACION_OXIGENO    NUMBER,
    FECHA_REGISTRO        TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT PK_SIGNOS_VITALES PRIMARY KEY (ID_SIGNO),
    CONSTRAINT FK_SIGNOS_VITALES_PACIENTE
        FOREIGN KEY (ID_PACIENTE)
        REFERENCES PACIENTES(ID_PACIENTE)
);


--------------------------------------------------------------------------------
-- 4. TABLA ALERTAS_MEDICAS
-- Tabla usada por el flujo RabbitMQ.
--
-- Flujo:
-- FrontEnd -> API Gateway -> BFF -> productor-alertas
-- -> RabbitMQ cola.alertas.oracle -> consumidor-oracle -> ALERTAS_MEDICAS
--------------------------------------------------------------------------------

CREATE TABLE ALERTAS_MEDICAS (
    ID_ALERTA          NUMBER GENERATED BY DEFAULT ON NULL AS IDENTITY,
    ID_PACIENTE        NUMBER NOT NULL,
    TIPO_ALERTA        VARCHAR2(50),
    VALOR_DETECTADO    VARCHAR2(50),
    NIVEL_CRITICIDAD   VARCHAR2(30),
    MENSAJE_ALERTA     VARCHAR2(300),
    ORIGEN_MENSAJE     VARCHAR2(80),
    FECHA_ALERTA       TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT PK_ALERTAS_MEDICAS PRIMARY KEY (ID_ALERTA),
    CONSTRAINT FK_ALERTAS_PACIENTE
        FOREIGN KEY (ID_PACIENTE)
        REFERENCES PACIENTES(ID_PACIENTE)
);


--------------------------------------------------------------------------------
-- 5. TABLA ALERTAS_KAFKA
-- Tabla usada por el flujo Kafka / Streaming.
--
-- Flujo:
-- productor-senales -> topic senales_vitales
-- -> procesador-senales -> topic alertas
-- -> consumidor-alertas-oracle -> ALERTAS_KAFKA
-- -> BFF -> API Gateway -> FrontEnd
--------------------------------------------------------------------------------

CREATE TABLE ALERTAS_KAFKA (
    ID_ALERTA        NUMBER GENERATED BY DEFAULT ON NULL AS IDENTITY,
    FECHA_ALERTA     TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    ID_PACIENTE      VARCHAR2(50),
    MENSAJE          VARCHAR2(300),
    NOMBRE_PACIENTE  VARCHAR2(150),
    TIPO_ANOMALIA    VARCHAR2(80),
    VALOR_DETECTADO  NUMBER(10,2),
    CONSTRAINT PK_ALERTAS_KAFKA PRIMARY KEY (ID_ALERTA)
);


