--------------------------------------------------------------------------------
-- 8. CONSULTAS DE VALIDACIÓN
--------------------------------------------------------------------------------

-- Ver pacientes registrados.
SELECT ID_PACIENTE, NOMBRE_APELLIDO, CRITICIDAD, HABITACION
FROM PACIENTES
ORDER BY ID_PACIENTE;

-- Ver alertas RabbitMQ guardadas en Oracle.
SELECT *
FROM ALERTAS_MEDICAS
ORDER BY ID_ALERTA DESC
FETCH FIRST 10 ROWS ONLY;

-- Ver alertas Kafka guardadas en Oracle.
SELECT *
FROM ALERTAS_KAFKA
ORDER BY ID_ALERTA DESC
FETCH FIRST 10 ROWS ONLY;

-- Revisar que la FK de ALERTAS_MEDICAS apunte a PACIENTES.
SELECT
    c.constraint_name,
    c.table_name,
    cc.column_name,
    r.table_name AS tabla_referenciada,
    rc.column_name AS columna_referenciada
FROM user_constraints c
JOIN user_cons_columns cc
    ON c.constraint_name = cc.constraint_name
JOIN user_constraints r
    ON c.r_constraint_name = r.constraint_name
JOIN user_cons_columns rc
    ON r.constraint_name = rc.constraint_name
WHERE c.constraint_name = 'FK_ALERTAS_PACIENTE';
